{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ivf:schema:manifest:0.1",
  "title": "IVF manifest, format version 0.1",
  "description": "Structural rules for manifest.json. Cross-reference rules (scene targets, assets, unique ids and timestamps) are enforced in code, not here. Keep the numeric limits in sync with src/limits.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "title", "entry_scene", "scenes"],
  "properties": {
    "format": { "type": "string", "const": "IVF" },
    "format_version": { "type": "string", "const": "0.1" },
    "title": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "entry_scene": { "$ref": "#/$defs/id" },
    "scenes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video", "interactions"],
      "properties": {
        "video": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "interactions": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/choiceInteraction" }
        }
      }
    },
    "choiceInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at_seconds", "type", "prompt", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "at_seconds": { "type": "number", "minimum": 0, "maximum": 86400 },
        "type": { "type": "string", "const": "choice" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/choiceOption" }
        }
      }
    },
    "choiceOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "next_scene"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "next_scene": { "$ref": "#/$defs/id" }
      }
    }
  }
}
